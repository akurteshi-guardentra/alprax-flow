
# Stellar Configuration
VITE_STELLAR_NETWORK=TESTNET
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Feature Flags
VITE_ENABLE_TEST_FEATURES=true
VITE_ENABLE_DETAILED_LOGS=true

# Analytics
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_KEY=

# App Configuration
VITE_MAX_TRANSACTION_AMOUNT=1000
VITE_DEFAULT_CURRENCY=USD
VITE_API_TIMEOUT=30000

# Deployment URLs
VITE_DEPLOY_URL=http://localhost:8080
VITE_API_URL=https://api.yourapp.com
VITE_STAGING_API_URL=https://staging-api.yourapp.com
VITE_DEV_API_URL=http://localhost:8080

# App Versioning
VITE_APP_VERSION=0.1.0
