{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_APP_VERSION": "1.0.0",
    "VITE_VERCEL_ENV": "production"
  },
  "github": {
    "silent": true
  }
}
