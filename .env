# GitHub Pages Configuration for Alprax Flow

# Base paths for different environments
VITE_BASE_PATH=
VITE_GITHUB_PAGES_PATH=/alprax-flow/

# API Configuration
VITE_API_URL=https://api.example.com/v1
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_TESTNET=true

# Misc
VITE_APP_VERSION=${npm_package_version}
VITE_BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

# Lovable Integration
VITE_LOVABLE_PROJECT_ID=68de21be-8dfb-45ac-88dd-2da960ee8f93
